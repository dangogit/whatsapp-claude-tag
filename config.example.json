{
  "evolution": {
    "url": "http://127.0.0.1:8080",
    "apiKeyEnv": "AUTHENTICATION_API_KEY",
    "envFile": "~/whatsapp-claude-tag/deploy/evolution/.env"
  },
  "accounts": [
    {
      "name": "personal",
      "instance": "personal"
    }
  ],
  "triggers": [
    "claude"
