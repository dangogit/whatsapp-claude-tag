# Copy to .env and replace both values, for example with: openssl rand -hex 24
# whatsapp-claude-tag reads the API key from this file: point the config's
# evolution.envFile here with evolution.apiKeyEnv set to AUTHENTICATION_API_KEY.
AUTHENTICATION_API_KEY=change-me
POSTGRES_PASSWORD=change-me
# Host port for the API (always bound to 127.0.0.1).
EVOLUTION_PORT=8080
